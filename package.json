{
  "name": "openfolks",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first desktop multi-agent workplace for Desk and Crews.",
  "homepage": "http://github.com/manasdutta04/openfolks",
  "repository": {
    "type": "git",
    "url": "http://github.com/manasdutta04/openfolks.git"
  },
  "author": {
    "name": "OpenFolks contributors"
  },
  "license": "MIT",
  "desktopName": "com.openfolks.app.desktop",
  "type": "module",
  "main": "apps/shell/main.mjs",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "lint": "oxlint .",
    "check:contrast": "node scripts/check-skin-contrast.mjs",
    "i18n:check": "node scripts/generate-locale.mjs --check",
    "dev": "vite",
    "docs:dev": "pnpm --filter @openfolks/docs dev",
    "docs:build": "pnpm --filter @openfolks/docs build",
    "docs:preview": "pnpm --filter @openfolks/docs preview",
    "dev:server": "node --experimental-strip-types apps/harness/index.ts",
    "mcp": "node --experimental-strip-types scripts/mcp-server.ts",
    "control:folks": "node --experimental-strip-types scripts/control-folks.ts",
    "dev:desktop": "node scripts/prepare-cloudflared.mjs --current && node scripts/launch-desktop.mjs",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "test": "vitest run && pnpm broker:test && pnpm test:electron && pnpm test:packaged-server",
    "test:electron": "node --test \"apps/shell/*.node-test.mjs\"",
    "bench:observation": "node --experimental-strip-types scripts/bench-observation.ts",
    "test:watch": "vitest",
    "test:cua": "pnpm build:cua && node scripts/smoke-cua.mjs",
    "test:cua-container": "node scripts/smoke-cua-container.mjs",
    "check:electron": "node scripts/check-electron.mjs",
    "preview": "vite preview",
    "build:server": "tsc -p tsconfig.server.build.json && node scripts/bundle-server.mjs",
    "build:speech": "node apps/shell/build-speech-helper.mjs",
    "build:recorder": "node apps/shell/build-recorder-helper.mjs",
    "build:cua": "node scripts/prepare-cua.mjs",
    "build:cloudflared": "node scripts/prepare-cloudflared.mjs",
    "build:cua:linux": "node scripts/prepare-cua-linux.mjs",
    "build:cua:linux:offline": "node scripts/prepare-cua-linux.mjs --offline",
    "build:updater": "node scripts/bundle-updater.mjs",
    "build:browser-snapshot": "node scripts/build-browser-snapshot.mjs",
    "package:prepare": "pnpm build && pnpm build:server && pnpm build:updater && pnpm build:cloudflared",
    "package:mac": "pnpm package:prepare && pnpm build:speech && pnpm build:recorder && pnpm build:cua && electron-builder --mac --publish never",
    "package:win": "pnpm package:prepare && electron-builder --win --publish never",
    "package:linux": "pnpm package:prepare && pnpm build:cua:linux && electron-builder --linux --x64 --publish never",
    "package:linux:offline": "pnpm package:prepare && pnpm build:cua:linux:offline && electron-builder --linux --x64 --publish never",
    "smoke:deb-command": "node scripts/smoke-deb-command.mjs",
    "smoke:linux-update": "xvfb-run -a electron --no-sandbox scripts/smoke-linux-update.mjs",
    "smoke:linux-package": "node scripts/run-linux-package-smoke.mjs",
    "smoke:cua-x11-input": "node scripts/smoke-cua-x11-input.mjs",
    "package:linux:dir": "pnpm package:prepare && pnpm build:cua:linux && electron-builder --linux dir --x64 --publish never",
    "package": "pnpm package:mac",
    "test:packaged-server": "pnpm build:server && node scripts/smoke-packaged-server.mjs",
    "broker:types": "wrangler types --config cloudflare/composio-broker/wrangler.jsonc cloudflare/composio-broker/worker-configuration.d.ts",
    "broker:check": "pnpm broker:types && tsc -p cloudflare/composio-broker/tsconfig.json",
    "broker:test": "vitest run --config cloudflare/composio-broker/vitest.config.ts",
    "broker:deploy": "wrangler deploy --config cloudflare/composio-broker/wrangler.jsonc",
    "control-plane:types": "pnpm --filter @openfolks/control-plane types",
    "control-plane:check": "pnpm --filter @openfolks/control-plane check",
    "control-plane:test": "pnpm --filter @openfolks/control-plane test",
    "control-plane:dry-run": "pnpm --filter @openfolks/control-plane dry-run"
  },
  "dependencies": {
    "@trycua/cua-driver": "0.20.0",
    "@usespaceui/avatars": "^0.1.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.539.0",
    "posthog-js": "^1.415.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.3.1",
    "yaml": "^2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "oxlint": "1.80.0",
    "rcedit": "^5.0.2",
    "tailwindcss": "^4.1.11",
    "typebox": "1.3.7",
    "typescript": "^5.8.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.10",
    "wrangler": "4.123.0"
  },
  "pnpm": {
    "supportedArchitectures": {
      "cpu": [
        "arm64",
        "x64"
      ]
    }
  }
}
